{
  "name": "take-home-test",
  "version": "1.0.0",
  "description": "Take home test project",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "migrate": "ts-node src/db/migrate.ts latest",
    "migrate:down": "ts-node src/db/migrate.ts down",
    "db:types": "kysely-codegen --camel-case --out-file src/db/types.ts",
    "db:setup": "npm run db:up && sleep 3 && npm run migrate && npm run db:types"
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "jest": "^29.7.0",
    "kysely-codegen": "^0.20.0",
    "prettier": "^3.9.6",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "kysely": "^0.28.17",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
